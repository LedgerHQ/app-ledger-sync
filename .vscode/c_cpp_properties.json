{
    "env": {
        "BOLOS_SDK": "/opt/ledger-secure-sdk"
    },
    "configurations": [
        {
            "name": "Nano X",
            "includePath": [
                "/usr/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/*/gen_src",
                "${env:BOLOS_SDK}/**"
            ],
            "defines": [
                "OS_IO_SEPROXYHAL",
                "HAVE_NBGL",
                "HAVE_SPRINTF",
                "SCREEN_SIZE_WALLET",
                "HAVE_ECC",
                "UNUSED(x)=(void)x",
                "DEBUG=1",
                "HAVE_PRINTF",
                "PRINTF=screen_printf",
                "HAVE_LEDGER_PKI"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}
